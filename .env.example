PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
# Required when NODE_ENV=production (the server refuses to start without it)
JWT_SECRET=replace-with-a-secure-random-string
# SQLite paths are relative to prisma/ (this is prisma/dev.db). Use a postgresql:// URL in
# production so reviews survive restarts (see README).
DATABASE_URL="file:./dev.db"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side key with "Places API (New)" enabled, used by npm run sync:google-ratings
GOOGLE_MAPS_API_KEY=

# Number of proxies in front of the app (Render, Cloud Run: 1). Needed for per-visitor rate limits.
TRUST_PROXY=1

# CAPTCHA (turnstile or recaptcha)
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# Email OTP verification (only needed for accounts whose email Google has not verified)
EMAIL_OTP_SECRET=replace-with-another-secure-random-string
REQUIRE_EMAIL_VERIFIED=true

# SMTP for verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limits (per signed-in account)
REVIEW_RATE_LIMIT_WINDOW_MS=900000
REVIEW_RATE_LIMIT_MAX=5
EMAIL_OTP_SEND_WINDOW_MS=600000
EMAIL_OTP_SEND_MAX=3
EMAIL_OTP_VERIFY_WINDOW_MS=600000
EMAIL_OTP_VERIFY_MAX=10
