{
  "name": "hk-kindergarten-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "node -r ts-node/register/transpile-only --test --test-reporter=spec test/config.test.ts test/names.test.ts test/ranking.test.ts test/import.test.ts test/api.test.ts",
    "render-build": "node render-build.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "import:kindergartens": "ts-node src/scripts/importKindergartens.ts",
    "import:gov:kgp": "ts-node src/scripts/importGovKgp.ts",
    "sync:google-ratings": "ts-node src/scripts/syncGoogleRatings.ts",
    "prelaunch:check": "powershell -ExecutionPolicy Bypass -File scripts/prelaunch-check.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cheerio": "^1.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "typescript": "5.4.3"
  }
}
